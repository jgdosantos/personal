# =============================================================================
# Variáveis usadas pelas funções serverless /api/comments e /api/brief
# (Vercel → Settings → Environment Variables). Nenhuma delas vai para o bundle
# do cliente.
# =============================================================================

# --- Supabase (SERVER-ONLY) --------------------------------------------------
# A service role key ignora RLS. Nunca expor no front-end.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key

# --- Resend (SERVER-ONLY) ----------------------------------------------------
# RESEND_FROM precisa ser um remetente de domínio verificado no Resend.
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=Proposta <proposta@seudominio.com.br>

# --- Destinatários das notificações -----------------------------------------
# Cliente comenta  -> e-mail vai para OWNER_EMAIL
# Você responde    -> e-mail vai para CLIENT_EMAIL
OWNER_EMAIL=joaogabrielsantosanjos@gmail.com
CLIENT_EMAIL=email-do-cliente@exemplo.com

# --- Identificação do dono ---------------------------------------------------
# Abra a proposta como /proposta-marcelo?owner=<OWNER_TOKEN> para comentar
# assinando como "João Gabriel". Sem o token, o visitante comenta como cliente.
OWNER_TOKEN=troque-por-um-segredo-longo

# --- Link usado no corpo do e-mail ------------------------------------------
PROPOSAL_URL=https://seudominio.com.br/proposta-marcelo


# =============================================================================
# BRIEFING DE MARCA — /api/brief
# =============================================================================
# SUPABASE_*, RESEND_*, OWNER_EMAIL e OWNER_TOKEN acima são compartilhados com
# /api/comments. As de baixo são exclusivas do briefing.

# --- Origem dos links montados no servidor -----------------------------------
# Usado para montar o link do briefing no e-mail e na planilha. Sem barra final.
SITE_URL=https://www.joaogsantos.com

# --- Bucket dos arquivos do cliente (SERVER-ONLY) ----------------------------
# Bucket PRIVADO no Supabase Storage. Público exporia o brandbook de um cliente
# a quem adivinhasse o caminho.
BRIEF_BUCKET=brand-briefs

# --- Planilha do Google (SERVER-ONLY) ----------------------------------------
# URL /exec do Apps Script publicado como App da Web, e o segredo que ele
# confere. Sem o segredo, qualquer um que descubra a URL escreve na planilha.
# Falha aqui é logada e não derruba o envio do briefing.
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/xxxxx/exec
SHEETS_WEBHOOK_SECRET=troque-por-um-segredo-longo
